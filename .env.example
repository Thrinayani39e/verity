# CockroachDB Cloud connection string (from Cloud Console -> Connect).
# Use the "General connection string" and add sslmode=verify-full.
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/verity?sslmode=verify-full

AWS_REGION=us-east-1

# Confirm model access in Bedrock console -> Model access before running.
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# S3 bucket for claim document uploads (must match db/schema.sql expectations
# and the ingestion Lambda's S3 event notification source bucket).
DOCUMENTS_BUCKET=verity-claim-documents

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
MAX_TXN_RETRIES=5
